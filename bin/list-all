#!/usr/bin/env bash

set -euo pipefail

# Git refs avoid GitHub's unauthenticated REST API rate limit and JSON layout.
versions=$(git ls-remote --tags --refs https://github.com/starship/starship.git |
	awk '$2 ~ /^refs\/tags\/v[0-9]+\.[0-9]+\.[0-9]+$/ {sub(/^refs\/tags\/v/, "", $2); print $2}' |
	sort -t. -k1,1n -k2,2n -k3,3n -u)

if [ -z "$versions" ]; then
	echo "No stable starship versions found" >&2
	exit 1
fi

printf '%s\n' "$versions" | tr '\n' ' ' | sed 's/ $//'
printf '\n'
